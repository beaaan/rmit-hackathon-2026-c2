# Copy to .env (gitignored) and fill in. Used by `npm run realm` (scripts/tide-realm.js).

# Master admin of your local TideCloak container. Pick a strong password; it never leaves this machine.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# The realm is licensed to this email under Tide's Terms & Conditions (https://tide.org/legal).
# Only the person who owns the deployment answers these.
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=
